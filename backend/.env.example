NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5174
DEFAULT_SHOP_SLUG=main
DEFAULT_SHOP_NAME=Stitchcraft Atelier
DEFAULT_SHOP_DOMAIN=localhost
TRUST_PROXY_HOPS=0
DEFAULT_PHONE_COUNTRY_CODE=91
MONGO_URI=mongodb://127.0.0.1:27017/tailor_management
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
SEED_ADMIN_EMAIL=admin@stitchcraft.local
SEED_ADMIN_PHONE=+91 90000 00001
SEED_ADMIN_PASSWORD=
SEED_TAILOR_EMAIL=tailor@stitchcraft.local
SEED_TAILOR_PHONE=+91 90000 00002
SEED_TAILOR_PASSWORD=
SEED_CUSTOMER_PHONE=+91 90000 00003
# Shop owner provisioning (operator-only CLI; never expose these values in a browser)
PROVISION_SHOP_NAME=
PROVISION_SHOP_SLUG=
PROVISION_SHOP_DOMAIN=
PROVISION_ADMIN_NAME=
PROVISION_ADMIN_EMAIL=
PROVISION_ADMIN_PHONE=
PROVISION_ADMIN_PASSWORD=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
UPLOAD_MAX_MB=5
